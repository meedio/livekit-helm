# egress v1.15.0 (Chrome 154.0.8037.57) rebuilt with Go 1.27.3, a patched
# golang.org/x/net and refreshed Ubuntu 24.04 packages.

APP_NAME=livekit-egress-image
IMAGE_TAG=v1.15.0-meedio.1

UPSTREAM_REPO=https://github.com/livekit/egress
UPSTREAM_TAG=v1.15.0
UPSTREAM_COMMIT=171423b0b3e7c6531de270b16f1db4f7a6bd2084

DOCKERFILE=build/egress/Dockerfile
BINARY=/bin/egress

# module@version, raised in go.mod before the build.
GO_MODULES="
golang.org/x/net@v0.62.0
"

# Build args baked into the Dockerfile as ARG defaults (the shared build action takes none).
# Upstream only publishes egress-templates as `latest`; PINNED_IMAGES fixes its digest.
BUILD_ARGS="
GSTVERSION=1.24.13
TEMPLATE_TAG=latest
"

# Every external image the Dockerfile pulls, pinned by digest.
PINNED_IMAGES="
livekit/egress-templates:latest@sha256:bb77bd0f3d54f993b91c0857f309d5bb3b8a3679f1d5827ec11cfb603091fc2b
livekit/gstreamer:1.24.13-dev@sha256:af6340618642b448f8dedcd5bf5d81c8ecd7392c4bbc33ec5052c7ec7a57b81b
livekit/gstreamer:1.24.13-prod@sha256:5f1e3632798c620448a40f0898687aded08dbeab6582064d471130af667a359a
livekit/chrome-installer:154.0.8037.57@sha256:7b8574eaf3e044a9f95032ca8f8195ee5800428972d301a840e97d27ebeab2d0
"

# OS package refresh appended to the final stage: apk or apt.
OS_REFRESH=apt
RUNTIME_USER=egress

# Packages the refresh must not upgrade. The Chrome .deb adds Google's apt repository, so
# without the hold the refresh would replace the pinned installer's Chrome with the latest
# stable. Update Chrome by bumping livekit/chrome-installer above.
HOLD_PACKAGES="google-chrome-stable"
