# Shared settings for every patched LiveKit image. Sourced by prepare.sh and verify.sh.

# Go toolchain the rebuilt binaries must report (`go version -m`).
GO_VERSION=1.27.3

# Image used to edit go.mod/go.sum and to inspect built binaries. Matches the
# builder image of upstream livekit-server v1.13.11.
GO_IMAGE=golang:1.27.3-alpine3.24@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd

REGISTRY=registry.meedio.eu
REGISTRY_PROJECT=meedio
