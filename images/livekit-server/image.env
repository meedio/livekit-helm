# livekit-server v1.13.11 rebuilt with a patched golang.org/x/net.
# Upstream already builds with Go 1.27.3 on a digest-pinned Alpine 3.24.3.

APP_NAME=livekit-server-image
IMAGE_TAG=v1.13.11-meedio.1

UPSTREAM_REPO=https://github.com/livekit/livekit
UPSTREAM_TAG=v1.13.11
UPSTREAM_COMMIT=385aa40f9292fe1db8caad87301e4b285b7c198a

DOCKERFILE=Dockerfile
BINARY=/livekit-server

# module@version, raised in go.mod before the build.
GO_MODULES="
golang.org/x/net@v0.62.0
"

# Build args baked into the Dockerfile as ARG defaults (the shared build action takes none).
BUILD_ARGS=""

# Every external image the Dockerfile pulls, pinned by digest.
PINNED_IMAGES=""

# OS package refresh appended to the final stage: apk or apt.
OS_REFRESH=apk
RUNTIME_USER=
