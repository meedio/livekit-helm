# ingress v1.5.0 (latest release) rebuilt with Go 1.27.3, patched modules and
# refreshed Ubuntu 24.04 packages.

APP_NAME=livekit-ingress-image
IMAGE_TAG=v1.5.0-meedio.1

UPSTREAM_REPO=https://github.com/livekit/ingress
UPSTREAM_TAG=v1.5.0
UPSTREAM_COMMIT=363f6090d572db8eef5b60c273c0970826fb7ca6

DOCKERFILE=build/ingress/Dockerfile
BINARY=/bin/ingress

# module@version, raised in go.mod before the build.
GO_MODULES="
golang.org/x/net@v0.62.0
golang.org/x/text@v0.43.0
google.golang.org/grpc@v1.85.0
go.opentelemetry.io/otel@v1.47.0
go.opentelemetry.io/otel/metric@v1.47.0
go.opentelemetry.io/otel/trace@v1.47.0
github.com/go-jose/go-jose/v3@v3.0.5
github.com/pion/stun/v3@v3.1.7
github.com/pion/dtls/v3@v3.1.15
"

# Build args baked into the Dockerfile as ARG defaults (the shared build action takes none).
BUILD_ARGS="
GOVERSION=1.27.3
GSTVERSION=1.26.7
"

# Every external image the Dockerfile pulls, pinned by digest.
PINNED_IMAGES="
livekit/gstreamer:1.26.7-dev@sha256:983e465d28ed0af3a1b8ef1d57fd24928e15aa3748bb5709ef5d67ff52be3562
livekit/gstreamer:1.26.7-prod@sha256:24106f36a0bd1003bdd34d3d4840f84cb88062573269fdf7640732058b58f7ab
"

# OS package refresh appended to the final stage: apk or apt.
OS_REFRESH=apt
RUNTIME_USER=
